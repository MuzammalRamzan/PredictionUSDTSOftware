# ============================================
# REQUIRED CONFIGURATION
# ============================================

# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration (REQUIRED)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Admin Configuration (REQUIRED for admin functions)
# Comma-separated list of admin wallet addresses (lowercase)
ADMIN_ADDRESSES=0x1234567890abcdef1234567890abcdef12345678,0xabcdef1234567890abcdef1234567890abcdef12

# ============================================
# OPTIONAL BLOCKCHAIN CONFIGURATION
# ============================================
# Only needed if you want to sync data from smart contracts
# The backend works without these - it will use database records only

# Network Selection (mainnet or testnet)
NETWORK=testnet

# BSC RPC URLs
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Smart Contract Address
CONTRACT_ADDRESS=0xYourContractAddressHere
